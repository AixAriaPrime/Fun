# ---- Empire of Free LLMs: server configuration ----

# Port the backend listens on.
PORT=8080

# Per-model timeout in milliseconds for each fan-out call.
MODEL_TIMEOUT_MS=30000

# ---- OpenRouter (optional) ----
# Get a free key at https://openrouter.ai/keys . Free models end with ":free".
# Leave blank to run with the built-in no-key Mock provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Ollama (optional, fully local, no key) ----
# Install from https://ollama.com , then `ollama pull llama3`.
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434

# Public URL used in OpenRouter attribution headers (optional).
PUBLIC_APP_URL=http://localhost:8080
